div class="stimulus" data-controller="discounts"
  = form_with model: [:admin, discount], method: action == :create ? :post : :patch, local: false do |f|
    .row
      .col-4
        .field.discount-description
          = f.label t('.description')
          = f.text_area :description, class: "form-control form-control-sm"
          = render 'shared/record_message', record: discount, field: 'description'
        .row.justify-content-around
          .col-4
            .field.discount-value
              = f.label t('.value')
              = f.number_field :value, in: 0..100, class: "form-control form-control-sm"
              = render 'shared/record_message', record: discount, field: 'value'
          .col-4
            .field.discount-target
              = f.label t('.target')
              = f.select :target, discount_targets, {}, { class: "form-select form-select-sm" }
          .col-4
            .field.discount-active
              = f.label :active, t('.active'), { class: "form-check-label" }
              = f.check_box :active, { class: "form-check mx-1", checked: action == :create ? false : discount.active }, 1, 0
        .row.justify-content-end
          .col-4
            .align-content-end
              = link_to_add_nested(f, :conditions, '#discount-conditions', partial_locals: { condition_types: condition_types, condition: condition }, link_text: t('.add_condition'), link_classes: 'btn btn-outline-dark btn-sm mt-2', insert_method: :append)
      .col-8
        - if action == :create
          .row.justify-content-start#discount-conditions
            - if discount.conditions.any?
              - discount.conditions.each do |condition|
                = f.fields_for :conditions, condition do |discount_conditions_form|
                  = render 'discount_condition_fields', form: discount_conditions_form, condition_types: condition_types, condition: condition
            - else
              = f.fields_for :conditions do |discount_conditions_form|
                = render 'discount_condition_fields', form: discount_conditions_form, condition_types: condition_types
        - if action == :update
          .row.justify-content-start#discount-conditions
            - discount.conditions.each do |condition|
              = f.fields_for :conditions, condition do |discount_conditions_form|
                = render 'discount_condition_fields', form: discount_conditions_form, condition_types: condition_types, condition: condition
    - if action == :create
      = f.submit t('.add_discount'), class: "btn btn-dark my-3"
    - if action == :update
      = f.submit t('.update_discount'), class: "btn btn-dark my-3"
    button class="btn btn-dark btn-sm my-3 mx-2" data-action="click->discounts#dismissDiscountForm"
      =t('.cancel')