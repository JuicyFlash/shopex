.product-card.col-md-3.overflow-visible.flex-col
  .row.justify-content-between.my-2
    .col-md-9
      .brand
        = product.brand.title.capitalize
    .col-md-3
      .compare
        = render 'compare_carts/product_to_compare', product: product
  .title.my-4
    h5
      = link_to product.title.capitalize, product_path(product)      
  .picture.text-center
    - if product.images.attached?
      = image_tag(product.images.first.variant(resize_to_limit: [300, 200]), class: "product-picture")
    - else  
      = image_tag('abt-2.jpg', class: "product-picture")
  = render 'carts/put_product_form', product: product