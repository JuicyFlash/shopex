.container#compare-cart
  - if @compare_cart.cart_products.present?
    table class="table table-hover"
      thead
        tr
          td
          - @compare_cart.products.find_each do |compare_product|
            td id = "comparable-product-#{compare_product.id}"
              .compare-title
                = "#{ compare_product.title.capitalize }"
              = link_to product_path(compare_product)
                - if compare_product.images.attached?
                  = image_tag(compare_product.images.first.variant(resize_to_limit: [300, 200]), class: "compare-picture")
              .text-end
                = link_to compare_product_path(product: { product_id: compare_product.id } ), id: "remove-comparable-product-#{compare_product.id}", data: { turbo_method: :patch }, class: "btn btn-outline-dark btn-sm remove-compare-button"
                  = bi_icon('x')
      tbody
        tr
          td
            = "Брэнд"
          - @compare_cart.products.find_each do |compare_product|
            td id = "comparable-product-#{compare_product.id}-brand"
              .text-center
                = compare_product.brand.title
        tr
          td
            = "Цена"
          - @compare_cart.products.find_each do |compare_product|
            td id = "comparable-product-#{compare_product.id}-price"
              .text-center
                = format_price(compare_product.price)
        - Property.with_values.find_each do |property|
          tr
            td
              = property.name
            - @compare_cart.products.find_each do |compare_product|
              - product_properties = compare_product.product_property.where(property_id: property.id)
              td id = "comparable-product-#{compare_product.id}-property-#{property.id}"
                - if product_properties.empty?
                  .text-center
                    = "-"
                - else
                  - product_properties.find_each do |p_property|
                    .text-center
                      = p_property.property_value.value
  - else
    h5.text-center = "Ваша корзина пуста"